msgstr ""

#: ../../../gpu-programming/launching-kernels.md:543
msgid "`for_num_elems` helper"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:545
msgid ""
"For 1D data-parallel kernels, the common pattern is one thread per element:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:547
msgid "let config = LaunchConfig::for_num_elems(N as u32);\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:551
msgid ""
"This uses 256 threads per block and computes the grid size via ceiling "
"division: `grid_x = (N + 255) / 256`. It is a convenient 1D shape, but it is "
"still raw data; only preparation ties a configuration to a kernel."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:555
msgid "2D and 3D configurations"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:557
msgid "For matrix operations, use 2D block and grid dimensions:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:559
msgid ""
"let config = LaunchConfig {\n"
"    grid_dim: ((cols + 15) / 16, (rows + 15) / 16, 1),\n"
"    block_dim: (16, 16, 1),\n"
"    shared_mem_bytes: 0,\n"
"};\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:567
msgid ""
"Inside the kernel, combine `threadIdx_x()` / `blockIdx_x()` with their "
"`_y()` counterparts to compute row and column indices."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:570
msgid "Choosing block size"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:572
msgid ""
"The block size is the single most important tuning parameter (see the {ref}"
"`Execution Model <execution-choosing-block-size>` chapter for details). "
"Quick guidelines:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:576
msgid "**256** is a safe default for most kernels."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:577
msgid "**Powers of 2** (128, 256, 512) align with warp boundaries."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:578
msgid ""
"Use `#[launch_bounds]` to hint the compiler about your intended block size."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:580
msgid "Typed async launch"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:582
msgid ""
"With the `cuda-host` async feature enabled, `#[cuda_module]` also generates "
"borrowed and owned async methods. These return lazy `DeviceOperation` values "
"instead of enqueuing immediately. No stream is specified at launch time -- "
"the scheduling policy chooses one when the operation is executed:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:587
msgid ""
"use cuda_async::device_context::init_device_contexts;\n"
"use cuda_async::device_operation::DeviceOperation;\n"
"\n"
"init_device_contexts(0, 1)?;\n"
"let module = kernels::load_async(0)?;\n"
"\n"
"// SAFETY: this is 1D, buffers contain 1024 elements, and module/scheduler "
"share a context.\n"
"let op = unsafe {\n"
"    module.vecadd_async(\n"
"        LaunchConfig::for_num_elems(1024),\n"
"        &a_dev,\n"
"        &b_dev,\n"
"        &mut c_dev,\n"
"    )\n"
"}?;\n"
"\n"
"// Execute and wait\n"
"op.sync()?;\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:608
msgid ""
"Use the owned form when the operation must be spawned or stored as a "
"`'static` future:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:611
msgid ""
"use std::future::IntoFuture;\n"
"\n"
"// SAFETY: this is 1D, owned buffers contain 1024 elements, and contexts "
"match.\n"
"let op = unsafe {\n"
"    module.vecadd_async_owned(\n"
"        LaunchConfig::for_num_elems(1024),\n"
"        a_dev,\n"
"        b_dev,\n"
"        c_dev,\n"
"    )\n"
"}?;\n"
"\n"
"let (a_dev, b_dev, c_dev) = tokio::spawn(op.into_future()).await??;\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:627
msgid "Async buffer lifetimes"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:629
msgid "Async launches are lazy, so pointer lifetimes matter:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:631
msgid ""
"raw pointer shape:\n"
"  build op from CUdeviceptr\n"
"  drop buffer\n"
"  run op later  -> stale pointer\n"
"\n"
"borrowed typed shape:\n"
"  build op from &DeviceBuffer\n"
"  Rust keeps the buffer borrowed until op completes\n"
"\n"
"owned typed shape:\n"
"  move DeviceBox into op\n"
"  spawned task owns the allocation until completion\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:646
msgid ""
"For a contracted kernel, both async forms accept `&PreparedLaunch<K>` and "
"are safe. `cuda_launch_async!` remains a lower-level unsafe migration API; "
"its invocation must be inside an `unsafe` block. Raw pointer async launches "
"are only correct when the caller can prove that the allocation outlives the "
"lazy operation."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:652
msgid "`.sync()` vs `.await`"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:27
msgid "Method"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:27
msgid "What it does"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:27
msgid "`.sync()`"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:27
msgid ""
"Execute on the default scheduling policy, block the current thread until "
"complete"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:27
msgid "`.await`"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:27
msgid "Execute and yield the current async task (requires a Tokio runtime)"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:659
msgid "Composing GPU work"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:661
msgid ""
"`DeviceOperation` supports functional composition. Chain operations with "
"`and_then` and run independent work in parallel with `zip!`:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:664
msgid ""
"use cuda_async::zip;\n"
"\n"
"let forward_pass = layer1_op\n"
"    .and_then(|output1| layer2_op(output1))\n"
"    .and_then(|output2| layer3_op(output2));\n"
"\n"
"// Run two independent operations concurrently\n"
"let combined = zip!(branch_a, branch_b);\n"
"let (result_a, result_b) = combined.sync()?;\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:676
msgid ""
"Each operation in the chain is scheduled onto a stream only when it "
"executes. The `and_then` combinator passes the output of one operation as "
"input to the next, forming a lazy computation graph."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:681
msgid ""
"The [Async GPU Programming](../async-programming/the-device-operation-model."
"md) section covers `DeviceOperation`, scheduling policies, and stream "
"management in depth."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:686
msgid "Cluster launch"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:688
msgid ""
"Thread Block Clusters (Hopper and newer) allow blocks to cooperate beyond "
"shared memory via **distributed shared memory** (DSMEM). To launch with "
"clusters, add `#[cluster_launch]` to the kernel and include `cluster_dim` in "
"the launch:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:692
msgid ""
"use cuda_device::{kernel, cluster, cluster_launch, DisjointSlice};\n"
"\n"
"#[kernel]\n"
"#[cluster_launch(4, 1, 1)]\n"
"pub fn cluster_kernel(mut out: DisjointSlice<u32>) {\n"
"    let rank = cluster::block_rank();\n"
"    // Blocks 0-3 can communicate via DSMEM\n"
"}\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:703
msgid ""
"On the host, the launch uses `launch_kernel_ex` (the extended launch API) "
"with cluster dimensions. `cuda_launch!` supports this via the `cluster_dim` "
"field:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:706
msgid ""
"// SAFETY: args/config match cluster_kernel, including its 4-block cluster;\n"
"// out_dev stays live through synchronization.\n"
"unsafe {\n"
"    cuda_launch! {\n"
"        kernel: cluster_kernel,\n"
"        stream: stream,\n"
"        module: module,\n"
"        config: config,\n"
"        cluster_dim: (4, 1, 1),\n"
"        args: [slice_mut(out_dev)]\n"
"    }\n"
"}\n"
".expect(\"Cluster launch failed\");\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:723
msgid ""
"Cluster launch requires **Hopper (sm_90)** or newer. The maximum cluster "
"size is typically 16 blocks. Use `cargo oxide build --arch sm_90` to target "
"Hopper."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:727
msgid "Cooperative launch"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:729
msgid ""
"Grid-wide barriers (`cuda_device::grid::sync()` or `this_grid().sync()`) "
"only work when every block in the grid is resident on the device at the same "
"time. A **cooperative launch** asks the driver to guarantee exactly that; "
"without it, blocks that have not been scheduled yet can never reach the "
"barrier and the kernel deadlocks."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:735
msgid ""
"On the typed `#[cuda_module]` path, mark the kernel with "
"`#[cooperative_launch]`. Every generated launch method (sync, async, and "
"owned-async) then submits through `cuLaunchKernelEx` with the "
"`CU_LAUNCH_ATTRIBUTE_COOPERATIVE` attribute set:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:740
msgid ""
"use cuda_device::{cooperative_launch, grid, kernel, DisjointSlice};\n"
"\n"
"#[cuda_module]\n"
"mod kernels {\n"
"    use super::*;\n"
"\n"
"    #[kernel]\n"
"    #[cooperative_launch]\n"
"    pub fn grid_sync_kernel(mut out: DisjointSlice<u32>) {\n"
"        // ... per-block work ...\n"
"        grid::sync();\n"
"        // ... grid-wide post-barrier work ...\n"
"    }\n"
"}\n"
"\n"
"let module = kernels::load(&ctx)?;\n"
"// SAFETY: config satisfies the kernel's indexing, residency, and output "
"bounds.\n"
"unsafe { module.grid_sync_kernel(&stream, config, &mut out_dev) }?;\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:761
msgid ""
"Unlike `#[cluster_launch]`, the attribute changes nothing in the PTX; it "
"only changes how the host submits the launch. The two attributes may be "
"combined on one kernel, in which case both launch attributes go into the "
"same `cuLaunchKernelEx` call."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:766
msgid ""
"The legacy (caller-unsafe) `cuda_launch!` macro offers the same behaviour "
"through its `cooperative: true` field."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:770
msgid ""
"The whole grid must fit on the device in a single wave, or the driver "
"rejects the launch with `CUDA_ERROR_COOPERATIVE_LAUNCH_TOO_LARGE`. Size the "
"grid from `cuOccupancyMaxActiveBlocksPerMultiprocessor` (blocks per SM × SM "
"count) when in doubt."
msgstr ""

