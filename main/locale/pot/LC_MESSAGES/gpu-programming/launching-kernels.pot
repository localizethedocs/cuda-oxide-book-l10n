#: ../../../gpu-programming/launching-kernels.md:115
msgid ""
"Raw typed launch methods return `Result<(), DriverError>`. The `Ok` case "
"means the kernel was successfully **enqueued** -- not that it finished. To "
"check for runtime errors (e.g., out-of-bounds trap), synchronize the stream "
"or context afterward."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:120
msgid "Safe prepared launches"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:122
msgid "Declare the kernel's geometry when it is part of correctness:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:124
msgid ""
"use cuda_core::LaunchConfig1D;\n"
"use cuda_device::{cuda_module, kernel, launch_bounds, launch_contract, "
"thread, DisjointSlice};\n"
"\n"
"#[cuda_module]\n"
"mod contracted {\n"
"    use super::*;\n"
"\n"
"    #[kernel]\n"
"    #[launch_bounds(256)]\n"
"    #[launch_contract(domain = 1, block = (256, 1, 1))]\n"
"    pub fn vecadd(a: &[f32], b: &[f32], mut c: DisjointSlice<f32>) {\n"
"        let idx = thread::index_1d();\n"
"        if let Some(c_elem) = c.get_mut(idx) {\n"
"            *c_elem = a[idx.get()] + b[idx.get()];\n"
"        }\n"
"    }\n"
"}\n"
"\n"
"let module = contracted::load(&ctx)?;\n"
"let config = LaunchConfig1D::new(4, 256, 0);\n"
"let prepared = module.prepare_vecadd(config)?;\n"
"module.vecadd(&stream, &prepared, &a, &b, &mut c)?;\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:149
msgid ""
"`prepare_vecadd` checks the exact block shape, device limits, dynamic shared "
"memory, context, and any cluster/cooperative requirements. `LaunchConfig1D` "
"cannot represent active Y/Z dimensions, and `PreparedLaunch<vecadd>` cannot "
"be used with another kernel. Preparation may fail; once it succeeds, the "
"branded launch can be reused safely."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:155
msgid ""
"Cluster and cooperative attributes may be declared together "
"(`#[cluster_launch(...)]` + `#[cooperative_launch]`). Preparation proves the "
"cluster shape with `cuOccupancyMaxActiveClusters`, then requires the whole "
"grid to fit in that concurrent cluster capacity so a cooperative `grid::"
"sync()` cannot hang on non-resident blocks. An oversized grid fails "
"preparation with `LaunchContractError::CooperativeGridTooLarge` (or a "
"related cluster residency error) instead of submitting an unsound launch."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:163
msgid ""
"For a contracted kernel, the raw escape hatch is named `vecadd_unchecked` "
"and remains unsafe. Uncontracted kernels expose only unsafe raw launch "
"methods."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:166
msgid "Compile-time policy configuration"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:168
msgid ""
"A kernel policy is a named collection of compile-time choices. It can "
"describe tile shapes, operation atoms, launch bounds, loop-unroll factors, "
"or any other configuration that a kernel library wants to expose."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:172
msgid ""
"Policies are represented by Rust types rather than runtime values. A generic "
"kernel is monomorphized once for every concrete policy type used by the host:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:175
msgid ""
"transform::<SmallTilePolicy> -> transform_TID_<A>\n"
"transform::<WideTilePolicy>  -> transform_TID_<B>\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:180
msgid ""
"Each specialization has its own PTX entry point and its own folded "
"constants. The policy is not passed as a kernel argument, and the generated "
"kernel does not contain a runtime branch that selects a policy."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:184
msgid "Define a domain-specific policy"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:186
msgid ""
"`cuda_device::config::Policy` deliberately contains only a stable "
"identifier. Kernel libraries extend it with associated types and constants "
"that are meaningful for their domain:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:190
msgid ""
"use cuda_device::config::{\n"
"    Atom, AtomKind, AtomSpec, Block, Global, Policy, PolicyId, RowMajor, "
"Shape1,\n"
"    Thread, Tile, TileSpec,\n"
"};\n"
"\n"
"enum XorRotate {}\n"
"impl AtomKind for XorRotate {}\n"
"\n"
"trait VectorPolicy: Policy {\n"
"    type BlockTile: TileSpec<\n"
"        Layout = RowMajor,\n"
"        MemorySpace = Global,\n"
"        Scope = Block,\n"
"    >;\n"
"\n"
"    type ElementAtom: AtomSpec<\n"
"        Kind = XorRotate,\n"
"        Scope = Thread,\n"
"    >;\n"
"\n"
"    const MAX_THREADS: u32;\n"
"    const MIN_BLOCKS: u32;\n"
"    const ITEMS_PER_THREAD: u32;\n"
"    const UNROLL: u32;\n"
"    const TAG: u32;\n"
"}\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:219
msgid ""
"`Tile`, `Atom`, `Shape`, layout, memory-space, and scope types are metadata. "
"They do not allocate memory, provide pointer access, emit an instruction, or "
"synchronize threads. The domain-specific trait and kernel implementation "
"decide what those descriptions mean and which combinations are valid."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:224
msgid "Define concrete policies"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:226
msgid ""
"A concrete policy implements both `Policy` and the domain-specific policy "
"trait:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:229
msgid ""
"enum SmallTilePolicy {}\n"
"\n"
"impl Policy for SmallTilePolicy {\n"
"    const ID: PolicyId =\n"
"        PolicyId::new(0x706f_6c69_6379_5f63, 1);\n"
"}\n"
"\n"
"impl VectorPolicy for SmallTilePolicy {\n"
"    type BlockTile =\n"
"        Tile<Shape1<1024>, RowMajor, Global, Block>;\n"
"\n"
"    type ElementAtom =\n"
"        Atom<XorRotate, Shape1<1>, Thread>;\n"
"\n"
"    const MAX_THREADS: u32 = 64;\n"
"    const MIN_BLOCKS: u32 = 2;\n"
"    const ITEMS_PER_THREAD: u32 = 16;\n"
"    const UNROLL: u32 = 2;\n"
"    const TAG: u32 = 0x1357_9bdf;\n"
"}\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:252
msgid ""
"A second policy can select a different tile, launch bound, and unroll factor "
"without duplicating the kernel:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:255
msgid ""
"enum WideTilePolicy {}\n"
"\n"
"impl Policy for WideTilePolicy {\n"
"    const ID: PolicyId =\n"
"        PolicyId::new(0x706f_6c69_6379_5f63, 2);\n"
"}\n"
"\n"
"impl VectorPolicy for WideTilePolicy {\n"
"    type BlockTile =\n"
"        Tile<Shape1<4096>, RowMajor, Global, Block>;\n"
"\n"
"    type ElementAtom =\n"
"        Atom<XorRotate, Shape1<1>, Thread>;\n"
"\n"
"    const MAX_THREADS: u32 = 256;\n"
"    const MIN_BLOCKS: u32 = 1;\n"
"    const ITEMS_PER_THREAD: u32 = 16;\n"
"    const UNROLL: u32 = 4;\n"
"    const TAG: u32 = 0x2468_ace0;\n"
"}\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:278
msgid ""
"`PolicyId` is an explicit library-facing identity. Its namespace and value "
"are supplied by the policy author and must remain stable while the policy's "
"generated behavior remains unchanged. It is not derived from Rust `TypeId`, "
"compiler mangling, a type name, or a compiler-generated hash."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:283
msgid ""
"cuda-oxide does not maintain a global policy-ID registry. A policy library "
"is responsible for choosing its namespace and preventing duplicate IDs."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:286
msgid "Use policy constants in a kernel"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:288
msgid ""
"Policy-associated constants can be used by supported compile-time attributes:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:290
msgid ""
"use cuda_device::{\n"
"    cuda_module, kernel, launch_bounds, launch_contract, thread,\n"
"};\n"
"\n"
"#[cuda_module]\n"
"mod kernels {\n"
"    use super::*;\n"
"\n"
"    #[kernel]\n"
"    #[launch_bounds(P::MAX_THREADS, P::MIN_BLOCKS)]\n"
"    #[launch_contract(domain = 1)]\n"
"    pub unsafe fn transform<P: VectorPolicy>(\n"
"        input: *const u32,\n"
"        output: *mut u32,\n"
"        count: u32,\n"
"    ) {\n"
"        let base =\n"
"            thread::index_1d().get()\n"
"                * P::ITEMS_PER_THREAD as usize;\n"
"\n"
"        let mut lane = 0;\n"
"\n"
"        #[unroll(P::UNROLL)]\n"
"        while lane < count {\n"
"            let index = base + lane as usize;\n"
"\n"
"            // SAFETY: the caller provides readable and writable storage\n"
"            // for every active thread and keeps count within the tile.\n"
"            let value =\n"
"                unsafe { input.add(index).read_volatile() } ^ P::TAG;\n"
"\n"
"            unsafe {\n"
"                output.add(index).write_volatile(value);\n"
"            }\n"
"\n"
"            lane += 1;\n"
"        }\n"
"    }\n"
"}\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:332
msgid ""
"rustc resolves the associated constants after monomorphization. cuda-oxide "
"therefore sees concrete values for each specialization:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:335
msgid ""
"SmallTilePolicy:\n"
"  launch_bounds = (64, 2)\n"
"  unroll         = 2\n"
"\n"
"WideTilePolicy:\n"
"  launch_bounds = (256, 1)\n"
"  unroll         = 4\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:345
msgid ""
"`MAX_THREADS` specifies the maximum block size accepted by that "
"specialization. It does not force every launch to use exactly that number of "
"threads."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:348
msgid ""
"`MIN_BLOCKS` is a compiler occupancy hint represented by PTX `."
"minnctapersm`. It is not a grid or block dimension and is not enforced as "
"launch geometry."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:352
msgid ""
"`UNROLL` is a partial-unroll factor. `UNROLL = 4` groups four loop "
"iterations per transformed loop body; it does not limit the loop to four "
"iterations. Runtime bounds and remainder iterations are preserved."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:356
msgid ""
"Invalid or unevaluatable policy expressions produce compilation errors "
"instead of silently using default values."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:359
msgid "Prepare a policy-specific launch"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:361
msgid ""
"Generic kernels generate generic host methods whose policy parameter selects "
"the concrete kernel specialization:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:364
msgid ""
"use cuda_core::LaunchConfig1D;\n"
"\n"
"let small_launch =\n"
"    module.prepare_transform::<SmallTilePolicy>(\n"
"        LaunchConfig1D::new(1, 64, 0),\n"
"    )?;\n"
"\n"
"let wide_launch =\n"
"    module.prepare_transform::<WideTilePolicy>(\n"
"        LaunchConfig1D::new(1, 256, 0),\n"
"    )?;\n"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:378
msgid ""
"The generated launch contract is evaluated independently for each "
"specialization:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:381
msgid "`SmallTilePolicy` rejects blocks larger than 64 threads."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:382
msgid "`WideTilePolicy` rejects blocks larger than 256 threads."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:384
msgid ""
"A prepared launch remains branded for the selected kernel specialization. A "
"`PreparedLaunch` created for one policy cannot be passed to another policy's "
"launch method."
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:388
msgid ""
"The policy changes compile-time code generation and launch validation, but "
"it does not prove raw-pointer memory safety. Kernels that accept raw "
"pointers remain unsafe to call:"
msgstr ""

#: ../../../gpu-programming/launching-kernels.md:392
msgid ""
"// SAFETY: the pointers cover the complete policy tile and remain valid\n"
"// until the stream completes the launch.\n"
"unsafe {\n"
"    module.transform::<SmallTilePolicy>(\n"
"        &stream,\n"
"        &small_launch,\n"
"        input,\n"
"        output,\n"
"        count,\n"
"    )?;\n"
"}\n"
msgstr ""

