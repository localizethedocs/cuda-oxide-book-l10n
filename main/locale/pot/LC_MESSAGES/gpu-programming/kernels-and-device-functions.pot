msgid "`cuda_device`"
msgstr ""

#: ../../../gpu-programming/kernels-and-device-functions.md:382
msgid "GPU intrinsics (threads, warps, shared memory)"
msgstr ""

#: ../../../gpu-programming/kernels-and-device-functions.md:382
