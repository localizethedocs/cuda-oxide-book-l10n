"use cuda_core::{peer, CudaContext, DriverError};\n"
"\n"
"fn enable_bidirectional_peer_access() -> Result<(), DriverError> {\n"
"    let ctx0 = CudaContext::new(0)?;\n"
"    let ctx1 = CudaContext::new(1)?;\n"
"\n"
"    if !peer::can_access_peer(&ctx0, &ctx1)? {\n"
"        return Ok(());\n"
