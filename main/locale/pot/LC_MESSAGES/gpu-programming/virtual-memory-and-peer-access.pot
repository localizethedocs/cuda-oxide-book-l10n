msgid ""
"ctx0.synchronize()?;\n"
"ctx1.synchronize()?;\n"
"\n"
"drop(mapping1);\n"
"drop(mapping0);\n"
"\n"
"drop(reservation1);\n"
"drop(reservation0);\n"
"\n"
"drop(physical);\n"
