msgstr ""

#: ../../../cute/overview.md:40
msgid ""
"In cute-rs, a `Tensor` pairs storage with a logical coordinate layout. "
"Splitting a vector into 4-element (16-byte) tiles and slicing the tile owned "
"by `tid` takes three lines:"
msgstr ""

#: ../../../cute/overview.md:42
msgid ""
"use cutlass_primitives as prims;\n"
"use prims::memory::DisjointSlice;\n"
"use prims::{cuda_module, kernel, thread};\n"
"\n"
"#[cuda_module]\n"
"mod kernels {\n"
"    use super::*;\n"
"\n"
"    #[kernel]\n"
"    pub fn add_f32(a: &[f32], b: &[f32], mut c: DisjointSlice<f32>) {\n"
"        let tid = thread::index_1d().get();\n"
"        let t_a = cute_rs::Tensor::from_slice(a).zipped_divide::"
"<4>().slice(tid);\n"
"        let t_b = cute_rs::Tensor::from_slice(b).zipped_divide::"
"<4>().slice(tid);\n"
"        let mut t_c = cute_rs::TensorMut::from_disjoint_slice(&mut "
"c).zipped_divide::<4>().slice(tid);\n"
"\n"
"        if t_a.is_full() {\n"
"            // Complete 16-byte tile -> lowers to a vectorized cute.copy\n"
"            unsafe { t_c.store(t_a.load() + t_b.load()) };\n"
"        } else {\n"
"            // Ragged boundary tile -> safe scalar tail loop\n"
"            let mut k = t_a.base();\n"
"            while k < a.len() {\n"
"                unsafe { t_c.store_at(k, a[k] + b[k]) };\n"
"                k += 1;\n"
"            }\n"
"        }\n"
"    }\n"
"}\n"
msgstr ""

#: ../../../cute/overview.md:75
msgid "Run and Inspect the Emitted CuTe MLIR"
msgstr ""

#: ../../../cute/overview.md:77
msgid ""
"Install the pinned CUTLASS 4.7 compiler once, then run any `*_cute` example "
"from `cuda-oxide/`:"
msgstr ""

#: ../../../cute/overview.md:79
msgid ""
"# Install the managed CUTLASS 4.7 compiler\n"
"cargo oxide toolchain install cutlass\n"
"\n"
"# Run the f32 + f16 elementwise example through the CUTLASS MLIR backend\n"
"CUDA_OXIDE_DEVICE_BACKEND=cutlass-mlir \\\n"
"  cargo oxide run elementwise_cute --arch sm_120a\n"
"\n"
"# Dump the prepared CUTLASS MLIR module to inspect the generated cute ops\n"
"CUDA_OXIDE_DEVICE_BACKEND=cutlass-mlir \\\n"
"CUDA_OXIDE_MLIR_OUTPUT=\"$PWD/module.mlir\" \\\n"
"  cargo oxide build elementwise_cute --arch sm_120a\n"
msgstr ""

#: ../../../cute/overview.md:94
msgid ""
"dialect-cute, dialect-mir, and dialect-nvvm coexist inside a **single Pliron "
"module** rather than acting as separate sequential passes. Before exporting "
"MLIR, dialect-cute's whole-module verifier checks tensor origins, pipeline "
"state transitions, and TMA/MMA layout and collector contracts."
msgstr ""
