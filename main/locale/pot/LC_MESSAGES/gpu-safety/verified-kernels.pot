#: ../../../gpu-safety/verified-kernels.md:73
msgid ""
"The launch grid is large enough when the kernel promises to write every "
"output element."
msgstr ""

#: ../../../gpu-safety/verified-kernels.md:74
msgid "**Paid per element on the GPU**:"
msgstr ""

#: ../../../gpu-safety/verified-kernels.md:75
msgid ""
"**Nothing.** Proven bounds checks are stripped out before PTX codegen, so "
"inner loops compile down to the exact same machine instructions as hand-"
"written unchecked code."
msgstr ""

